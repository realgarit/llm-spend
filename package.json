{
  "name": "llm-spend",
  "version": "0.1.0",
  "private": true,
  "description": "What LLM APIs actually cost. Real prices in USD and CHF, measured on Azure AI Foundry and direct APIs, with prompt-cache economics and cost verification.",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx --test src/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots=changed",
    "test:all": "npm test && npm run test:e2e",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
